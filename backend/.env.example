GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Set to "true" to enable LLM-as-judge scoring (faithfulness/relevance) after each
# chat response. Off by default — costs 3 extra Groq calls per message and scores
# aren't shown in the UI.
ENABLE_RAG_EVAL=false

# Set to "false" to disable multi-query rewriting before retrieval (on by default).
# Adds one extra fast-tier Groq call per non-trivial query to widen retrieval recall.
ENABLE_QUERY_REWRITE=true

# Gates /admin/* and all /documents/* routes (sent as the x-admin-key header).
# Unset means those routes return 503 — the Documents panel and Admin dashboard
# are unusable until this is set.
ADMIN_API_KEY=

# Comma-separated CORS origins for your deployed frontend. allow_credentials is on,
# so keep this to origins you control.
# ALLOWED_ORIGINS=https://chat.yourdomain.com

# Comma-separated IPs of reverse proxies allowed to set X-Forwarded-For. Required
# when running behind a proxy (including the bundled docker-compose frontend):
# without it, rate limiting keys every request on the proxy's own address, so all
# clients share one bucket and a single caller can throttle everyone.
# TRUSTED_PROXY_IPS=172.18.0.3
